# ==============================================================================
# Aletheia Environment Configuration
# ==============================================================================

# Aletheia Platform API
ALETHEIA_ENV=development
ALETHEIA_PORT=8000
ALETHEIA_LOG_LEVEL=INFO

# Simulated Production Database (PostgreSQL)
SIMULATOR_DB_HOST=localhost
SIMULATOR_DB_PORT=5432
SIMULATOR_DB_USER=aletheia
SIMULATOR_DB_PASSWORD=aletheia_secret
SIMULATOR_DB_NAME=checkout_db
SIMULATOR_DATABASE_URL=postgresql://aletheia:aletheia_secret@localhost:5432/checkout_db

# Simulated Production Checkout Service
CHECKOUT_API_HOST=0.0.0.0
CHECKOUT_API_PORT=8001
CHECKOUT_API_URL=http://localhost:8001
